rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'rehanvipmd@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin documents
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // On creation, normal users cannot grant themselves admin role or premium
      allow create: if isOwner(userId) &&
        incoming().uid == userId &&
        incoming().role == 'user' &&
        incoming().subscriptionStatus == 'free' &&
        incoming().planId == 'free' &&
        incoming().email is string &&
        incoming().email.size() <= 256;

      // On update, users can only modify their profile fields (displayName, photoURL)
      allow update: if (
        isOwner(userId) &&
        incoming().uid == userId &&
        incoming().role == existing().role &&
        incoming().planId == existing().planId &&
        incoming().subscriptionStatus == existing().subscriptionStatus &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // Conversations
    match /conversations/{conversationId} {
      allow get: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isVerified() &&
        incoming().userId == request.auth.uid &&
        incoming().title is string &&
        incoming().title.size() <= 200;

      allow update: if isVerified() &&
        resource.data.userId == request.auth.uid &&
        incoming().userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'model', 'updatedAt']);

      allow delete: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow get: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isVerified() &&
        incoming().userId == request.auth.uid &&
        incoming().content is string &&
        incoming().content.size() <= 65536;

      allow update: if false; // Messages are immutable once sent

      allow delete: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Public Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow get: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow get: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Daily Usage
    match /usage/{usageId} {
      allow get: if (
        (isVerified() && (usageId == request.auth.uid || usageId.matches('^' + request.auth.uid + '.*'))) ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create, update: if (
        (isVerified() && incoming().userId == request.auth.uid && (usageId == request.auth.uid || usageId.matches('^' + request.auth.uid + '.*'))) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admin Logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
